# Copy this file to ".env" (same folder) before running the app.
# Defaults below already match a fresh XAMPP install.

SECRET_KEY=change-this-to-a-random-secret-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gudlar_db

# Your WhatsApp number WITH country code, digits only (India = 91).
# Orders from the cart open a chat with this number.
WHATSAPP_NUMBER=919000000000

# Secret code needed to create a NEW admin account at /admin/register.
# Share it only with people you trust, and change it!
ADMIN_SIGNUP_CODE=gudlar-admin-2026
